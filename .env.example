# Database connection settings used by backend/database.py
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_inventory

# Flask / JWT - replace these with private random values
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# Optional values used by `python -m backend.scripts.create_admin`
ADMIN_FULL_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional external product lookup service
AUTOPARTS_API_KEY=
